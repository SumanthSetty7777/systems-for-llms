{
  "model": {
    "vocab_size": 10000,
    "context_length": 4096,
    "d_model": 512,
    "num_layers": 4,
    "num_heads": 8,
    "d_ff": 1344,
    "rope_theta": 10000.0,
    "attention_backend": "sdpa",
    "activation_checkpointing": "none"
  },
  "data": {
    "kind": "npy",
    "train_path": "../../assignment1-basics/data/TinyStories-train-tokens.npy",
    "valid_path": "../../assignment1-basics/data/TinyStories-valid-tokens.npy",
    "tokenizer_files": [
      "../../assignment1-basics/outputs/tokenizers/tinystories_10k_mp/vocab.pkl",
      "../../assignment1-basics/outputs/tokenizers/tinystories_10k_mp/merges.pkl"
    ]
  },
  "seed": 1337,
  "device": "cuda",
  "num_threads": 4,
  "batch_size": 2,
  "grad_accum_steps": 1,
  "precision": "bf16",
  "max_steps": 30,
  "learning_rate": 0.0003,
  "min_learning_rate": 3e-05,
  "warmup_steps": 5,
  "weight_decay": 0.1,
  "grad_clip": 1.0,
  "eval_interval": 30,
  "eval_batches": 1,
  "eval_batch_size": 1,
  "checkpoint_interval": 30
}
